  "keyFeatures": [
    "Distributed key-value storage with Raft consensus for strong consistency",
    "ACID-compliant distributed transactions using Percolator model",
    "Horizontal scalability to 100+ TBs via Placement Driver (PD) auto-sharding",
    "Multi-Version Concurrency Control (MVCC) for snapshot isolation",
    "Geo-replication across data centers",
    "Coprocessor framework for distributed computing push-down",
    "TLS encryption and role-based access control",
    "Backup/restore with point-in-time recovery (PITR)",
    "Change Data Capture (CDC) for real-time data streaming",
    "RocksDB-backed storage engine with Titan for large values"
  ],
  "publicApiSurface": [
    "RawClient.get / RawClient.put / RawClient.delete / RawClient.scan",
    "TransactionClient.begin / Transaction.get / Transaction.put / Transaction.commit",
    "gRPC KvGet / KvScan / KvPrewrite / KvCommit / KvRollback",
    "gRPC RawGet / RawPut / RawDelete / RawScan / RawBatchGet",
    "tikv-ctl raft / tikv-ctl store / tikv-ctl region / tikv-ctl compact",
    "tikv-ctl unsafe-recover / tikv-ctl snapshot / tikv-ctl tombstone",
    "HTTP Status API: /status / /metrics / /config / /region-meta",
    "Coprocessor plugin API (coprocessor_plugin_api)",
    "PD client API for cluster management and scheduling"
  ]
}
